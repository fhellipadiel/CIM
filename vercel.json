{
    "rewrites":  [
                     {
                         "source":  "/api/employee",
                         "destination":  "/api/checkout?signupAction=employee"
                     },
                     {
                         "source":  "/api/claim-referral",
                         "destination":  "/api/checkout?signupAction=claim-referral"
                     },
                     {
                         "source":  "/api/admin-media",
                         "destination":  "/api/checkout?signupAction=admin-media"
                     },
                     {
                         "source":  "/api/admin-access",
                         "destination":  "/api/checkout?signupAction=admin-access"
                     },
                     {
                         "source":  "/api/admin-recovery",
                         "destination":  "/api/checkout?signupAction=admin-recovery"
                     },
                     {
                         "source":  "/api/admin-mfa",
                         "destination":  "/api/checkout?signupAction=admin-mfa"
                     },
                     {
                         "source":  "/api/analytics",
                         "destination":  "/api/checkout?signupAction=analytics"
                     },
                     {
                         "source":  "/api/support",
                         "destination":  "/api/checkout?signupAction=support"
                     },
                     {
                         "source":  "/api/company-lookup",
                         "destination":  "/api/checkout?signupAction=company-lookup"
                     },
                     {
                         "source":  "/api/register-profile",
                         "destination":  "/api/checkout?signupAction=register-profile"
                     },
                     {
                         "source":  "/admin",
                         "destination":  "/adm.html"
                     },
                     {
                         "source":  "/login",
                         "destination":  "/login.html"
                     },
                     {
                         "source":  "/funcionario",
                         "destination":  "/funcionario.html"
                     },
                     {
                         "source":  "/:slug([a-zA-Z0-9_-]+)",
                         "destination":  "/index.html"
                     }
                 ],
    "buildCommand":  "npm run build",
    "outputDirectory":  "public",
    "functions":  {
                      "api/*.js":  {
                                       "maxDuration":  60
                                   }
                  },
    "headers":  [
                    {
                        "source":  "/(.*)",
                        "headers":  [
                                        {
                                            "key":  "X-Content-Type-Options",
                                            "value":  "nosniff"
                                        },
                                        {
                                            "key":  "X-Frame-Options",
                                            "value":  "DENY"
                                        },
                                        {
                                            "key":  "Referrer-Policy",
                                            "value":  "strict-origin-when-cross-origin"
                                        },
                                        {
                                            "key":  "Permissions-Policy",
                                            "value":  "camera=(), microphone=(), geolocation=()"
                                        },
                                        {
                                            "key":  "Content-Security-Policy",
                                            "value":  "frame-ancestors \u0027none\u0027; object-src \u0027none\u0027; base-uri \u0027self\u0027; form-action \u0027self\u0027 https://www.mercadopago.com.br; upgrade-insecure-requests"
                                        }
                                    ]
                    },
                    {
                        "source":  "/adm.html",
                        "headers":  [
                                        {
                                            "key":  "Cache-Control",
                                            "value":  "private, no-store, max-age=0"
                                        }
                                    ]
                    },
                    {
                        "source":  "/recuperar-acesso.html",
                        "headers":  [
                                        {
                                            "key":  "Cache-Control",
                                            "value":  "private, no-store, max-age=0"
                                        },
                                        {
                                            "key":  "X-Robots-Tag",
                                            "value":  "noindex, nofollow"
                                        }
                                    ]
                    }
                ]
}
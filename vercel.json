{
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/adm.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/:slug([a-zA-Z0-9_-]+)",
      "destination": "/index.html"
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  }
}
